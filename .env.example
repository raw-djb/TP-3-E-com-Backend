# Copy this file to a new file named .env (run: npm run setup)
# Then replace the values below with your own.

PORT=3000

# From MongoDB Atlas: Connect > Drivers. Replace the password and add /lumiere before the ?
# Example shape: mongodb+srv://USER:PASSWORD@YOURCLUSTER.mongodb.net/lumiere?retryWrites=true&w=majority
# Or use a local MongoDB: mongodb://127.0.0.1:27017/lumiere
MONGODB_URI=your_mongodb_connection_string

# Any long random text
JWT_SECRET=replace_with_a_local_secret

CLIENT_ORIGIN=http://localhost:5173
